# Copy to .env. Public name clients use (the one served by the reverse proxy on 443).
RD_DOMAIN=rustdesk.example.com

# Address the ws listeners (21118 hbbs, 21119 hbbr) are published on. Keep loopback when the
# proxy runs on this host; otherwise use an address only the proxy can reach, never 0.0.0.0.
#RD_BIND=127.0.0.1

# Image tag built from ./server.
#RD_TAG=local

# Devices registered at the same time.
#RD_MAX_WS_PEERS=10000
# New device registrations accepted from one IP in a burst / distinct new ids per IP per day.
# Raise them when enrolling many devices from behind a single NAT address.
#RD_MAX_REG_PER_IP=30
#RD_MAX_IDS_PER_IP=300

# --- compose.allinone.yml only ---
# Image name. Default: the one built here by `make allinone`. Published by the CI:
#   RD_IMAGE=ghcr.io/manprint/rustdesk-allinone   with RD_TAG=1.0.0
#RD_IMAGE=rustdesk-allinone

# The mode (plain behind an edge proxy, the default, or ssl) is chosen in compose.allinone.yml
# with the lines tagged [plain] and [ssl].

# Host directory mounted on /data (server key pair and device database). Create it before the
# first start, owned by the user of the container:
#   sudo install -d -o 10001 -g 10001 -m 0700 ./data
#RD_DATA_DIR=./data

# [plain] Address (or CIDR) the edge proxy connects from, as the container sees it. The default is
# the gateway of the compose network, right for an edge proxy running on this host; with an edge
# proxy on another host put its address here.
#RD_EDGE_PROXY=172.31.251.1

# [ssl] Directory with fullchain.pem and privkey.pem, both readable by uid 10001:
#   sudo chown root:10001 certs/privkey.pem && sudo chmod 0640 certs/privkey.pem
#RD_CERT_DIR=./certs
